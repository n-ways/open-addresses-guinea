 "criteria": [
  {
   "rank": 1,
   "name": "Easy to remember, effortless to get",
   "rule": "The code people keep is a place name they already use plus a short number said in pairs; no letters or check character to remember; the app shows the code as soon as it knows where home is."
  },
  {
   "rank": 2,
   "name": "Stable",
   "rule": "A code never moves or changes; frames and areas are frozen; administrative reforms change labels only."
  },
  {
   "rank": 3,
   "name": "Compound and door level",
   "rule": "The address names the compound (concession); its gate is the destination; structures, doors and flats are sub-units."
  },
  {
   "rank": 4,
   "name": "Works offline",
   "rule": "Spot and bloc codes need only frames.json; home codes come from the area registry carried on the phone."
  },
  {
   "rank": 5,
   "name": "Official first",
   "rule": "Where the state has an address, use its data as written (see precedence); N-Ways codes fill only the gaps; never called official until adopted."
  },
  {
   "rank": 6,
   "name": "Open",
   "rule": "Method, engine and code data public under open licences (licence choice pending)."
  },
  {
   "rank": 7,
   "name": "Privacy",
   "rule": "Codes describe places, never people; no resident names or counts."
  }
 ],
