 "gettingACode": {
  "appShowsCode": [
   "open N-Ways at home or save home (1 tap)",
   "the card \"Votre code maison / Your home code\" appears",
   "tap Partager → WhatsApp or SMS link"
  ],
  "steps": {
   "existingHome": 2,
   "newHome (Add my home)": 6,
   "courierLookup": 1
  },
  "channels": [
   "N-Ways app",
   "plate / QR sticker on the gate",
   "Add my home",
   "partners look up a customer's code (partner API)"
  ],
  "notOffered": "No USSD. An SMS look-up service is a possible later option, not part of this design."
 },
 "addMyHome": {
  "steps": [
   "stand at the gate: GPS averaged 10 s + one gate photo → entrance /1",
   "outline: tap corners on imagery | walk the boundary with AR (ARKit/ARCore) anchored by averaged GPS | import survey plan beacons",
   "describe: households (number only), structures, floors, use",
   "provisional code: free number nearest the middle of the gap between Hilbert neighbours",
   "confirmed: deliveries/arrivals, no dispute, or new imagery"
  ],
  "safeguards": [
   "a code is an address, not a land title",
   "overlaps flagged, not issued",
   "gate on outline; 30–20,000 m2; closed loop; GPS vs AR within 5 m",
   "only outline + one gate photo kept",
   "offline: spot/bloc code at once, home code on next connection"
  ],
  "cadastre": {
   "holder": "Direction nationale des domaines et du cadastre (unverified)",
   "law": "Code foncier et domanial, Ordonnance O/92/019 of 30 Mar 1992 (unverified)",
   "datum": "Dabola 1981 / UTM 28N (EPSG:3461) legacy; WGS 84 / UTM 28N–29N (EPSG:32628/32629) presumed for new plans (unverified)",
   "surveyors": "sworn géomètres; professional order unconfirmed",
   "openParcels": "none known"
  }
 },
 "privacy": {
  "law": "Loi L/2016/037/AN of 28 Jul 2016 (cybersecurity and personal data protection); decree of 14 Apr 2025 on civil-status/identification data",
  "authority": "art. 47 authority not constituted (2021, DLA Piper); 2026 status unverified",
  "duties": [
   "prior declaration of processing once the authority exists",
   "transfers abroad need authorisation — keep the registry's personal data (door confirmations, photos) minimal and consider hosting a copy in Guinea",
   "no resident data in the published registry"
  ],
  "design": "codes describe places; residential compounds carry no occupant data; household can request residential-only display"
 },
 "governance": {
  "partners": [
   "Poste GN SA",
   "ARPT",
   "Ministère des Postes, des Télécommunications et de l'Économie numérique",
   "Ministère de l'Urbanisme et de l'Habitat (programme national d'adressage)",
   "Gouvernorat de Conakry and its 13 communes",
   "ITCG / IGN Guinée",
   "INS",
   "Direction nationale des domaines et du cadastre",
   "ANSSI",
   "emergency services",
   "couriers, banks, utilities, mining operators"
  ],
  "contacted": "none yet",
  "details": "GOVERNANCE.md"
 },
 "memorabilityEvaluation": {
  "design": "randomised: 300 residents in Conakry (Hafia, Bonfi, Kipé), 150 in Labé and 150 in Kankan; each shown their home code in one of three forms (name+4 digits, bloc+digits, alphanumeric spot)",
  "measures": [
   "free recall after 1 day, 1 week and 4 weeks",
   "error rate by type (wrong digit, swapped pair, wrong area)",
   "time to say the code on the phone",
   "courier success finding the gate from the code alone"
  ],
  "languages": "recall tested in French and in the participant's first language (Pular, Maninka, Susu)",
  "target": ">= 80% exact recall after one week for name+digits; adopt the form with the best one-week recall"
 }
}